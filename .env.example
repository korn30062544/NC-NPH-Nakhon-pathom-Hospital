# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Firebase (client-side config) — used by src/firebase.ts for Auth + Firestore.
# These must be prefixed VITE_ to be readable in the browser bundle (Vite's
# convention — anything without this prefix is NOT exposed to client code).
# Firebase web API keys are not secret by design; real access control lives
# in firestore.rules, not in hiding this key. Values below are pre-filled
# from the firebase-applet-config.json you provided for this project —
# double check them against Project Settings > General in the Firebase
# console if anything doesn't work.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY="AIzaSyDsL6VFevVUky33IJ1-h4IHq72nf0tUe8E"
VITE_FIREBASE_AUTH_DOMAIN="gen-lang-client-0902192015.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="gen-lang-client-0902192015"
VITE_FIREBASE_STORAGE_BUCKET="gen-lang-client-0902192015.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="312382067217"
VITE_FIREBASE_APP_ID="1:312382067217:web:1fc26b364d699f98ee57b0"
# This project uses a NAMED Firestore database, not "(default)" — required
# for Firestore to work at all here (see firebase-applet-config.json).
VITE_FIREBASE_DATABASE_ID="ai-studio-nakhonpathomhosp-44425198-336c-4fe8-af57-16fda1795b54"
