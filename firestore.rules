rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidRiskIncident(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 256 &&
             data.departmentKey is string && data.departmentKey.size() <= 64 &&
             data.riskLevel is string && data.riskLevel.size() <= 32 &&
             data.approvalStatus is string && data.approvalStatus.size() <= 32;
    }

    function isValidDataSource(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 256 &&
             data.type is string && data.type.size() <= 64;
    }

    function isValidDashboardAggregate(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.totalEvents is number && data.totalEvents >= 0;
    }

    // Incidents Collection (Public read for hospital quality dashboard, authenticated write)
    // FIX: "isSignedIn() || true" always evaluates to true regardless of auth
    // state, so the original rule let anyone — signed in or not — create,
    // edit, or delete incident reports. Changed to require sign-in.
    match /incidents/{incidentId} {
      allow get, list: if true;
      allow create: if isValidId(incidentId) && isSignedIn() && isValidRiskIncident(request.resource.data);
      allow update: if isValidId(incidentId) && isSignedIn() && isValidRiskIncident(request.resource.data);
      allow delete: if isValidId(incidentId) && isSignedIn();
    }

    // Data Sources Collection (Google Sheets and Files connections)
    // FIX: create/update/delete had no auth check at all — anyone could add,
    // modify, or delete a connected data source. Now requires sign-in.
    match /dataSources/{sourceId} {
      allow get, list: if true;
      allow create: if isValidId(sourceId) && isSignedIn() && isValidDataSource(request.resource.data);
      allow update: if isValidId(sourceId) && isSignedIn() && isValidDataSource(request.resource.data);
      allow delete: if isValidId(sourceId) && isSignedIn();
    }

    // Materialized Dashboard Aggregates Collection (Real-time DB query cache)
    // FIX: create/update/delete had no auth check — now requires sign-in.
    match /dashboardAggregates/{aggregateId} {
      allow get, list: if true;
      allow create, update: if isValidId(aggregateId) && isSignedIn() && isValidDashboardAggregate(request.resource.data);
      allow delete: if isValidId(aggregateId) && isSignedIn();
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
